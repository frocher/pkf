{
  "name": "@pkf/core",
  "version": "0.1.0",
  "description": "Core parser and index for Project Knowledge Format bundles.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
